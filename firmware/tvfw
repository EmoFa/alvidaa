# /var/local/tvfw — alvidaa firewall policy (sourced by the boot hook)
#
# v2 (2026-11-05): the hook used to source this file at its very top,
# BEFORE /usr/local/bin/iptables existed, which silently no-op'd every
# rule here (verified 2026-11-05: OUTPUT chain empty after boot; manual
# late source landed the rules instantly). The policy is now
# self-deferring: it backgrounds a bounded wait for the iptables binary
# and applies once the system is actually ready — no hook edit needed.
# Tool paths are absolute; the DNS-dependent tier retries in the
# background instead of trusting boot-time DNS (findings 12 §5: DNS is
# not up until 25-35s, this file used to run at ~7s).
#
# Tier 0: DoH evasion countermeasure — force vidaahub lookups back to the
#         LAN resolver (AdGuard), where the domain rules apply.
# Tier 1: telemetry/event sinks (evidence: domain_list.json + wiretap).
# Domain-derived IPs are resolved in the background retry; CDN rotation
# means the resolver layer (AdGuard) is the durable kill — these are the
# in-kernel backstop.
#
# OTA freeze re-apply (alvidaa ota off): when
# /var/local/alvidaa/ota_freeze.state.sh exists, the freeze layer is
# re-applied from the sidecar's stored IPs — no boot-time DNS needed.
# The freeze rides the alvidaa surface, so /var/local/hook.off (the
# reversibility guarantee) also disarms it; `alvidaa ota status` warns
# when the kill-switch is present while a freeze is armed.

IPTABLES=/usr/local/bin/iptables
BUSYBOX=/var/local/tvtools/busybox

(
    # Bounded wait for the system to be ready (iptables mounted). At ~7s
    # boot time it is not; at ~30-60s it is.
    n=0
    while [ $n -lt 60 ]; do
        [ -x "$IPTABLES" ] && break
        sleep 5; n=$((n+1))
    done
    [ -x "$IPTABLES" ] || exit 1

    # --- Tier 0: DoH bootstrap (dns.google + hardcoded fallbacks) ---
    for ip in 8.8.8.8 8.8.4.4; do
        $IPTABLES -C OUTPUT -d $ip -p tcp --dport 443 -j REJECT 2>/dev/null || $IPTABLES -I OUTPUT 1 -d $ip -p tcp --dport 443 -j REJECT
        $IPTABLES -C OUTPUT -d $ip -p udp --dport 443 -j REJECT 2>/dev/null || $IPTABLES -I OUTPUT 1 -d $ip -p udp --dport 443 -j REJECT
    done

    # --- Tier 1: telemetry + ads (backgrounded retry: CDN rotation means
    #     AdGuard is the durable kill; this is the in-kernel backstop) ---
    (
        n=0
        while [ $n -lt 60 ]; do
            ok=1
            for host in evt-na.vidaahub.com ter-jrnl-na.vidaahub.com exc-jrnl-na.vidaahub.com policy-jrnl-na.vidaahub.com dvcstatus-dataretrv.vidaahub.com file-ul.vidaahub.com rsc-ads.vidaahub.com; do
                ips=$($BUSYBOX nslookup $host 2>/dev/null | awk '/^Address/{print $2}' | $BUSYBOX grep -v ':')
                [ -z "$ips" ] && ok=0
                for ip in $ips; do
                    $IPTABLES -C OUTPUT -d $ip -j REJECT 2>/dev/null || $IPTABLES -I OUTPUT 1 -d $ip -j REJECT
                done
            done
            [ $ok = 1 ] && exit 0
            sleep 5; n=$((n+1))
        done
    ) &

    # --- OTA freeze re-apply (alvidaa ota off) ---
    STATE_SH=/var/local/alvidaa/ota_freeze.state.sh
    if [ -f "$STATE_SH" ]; then
        . "$STATE_SH"
        $IPTABLES -N ALVIDAA_OTA 2>/dev/null
        for ip in $OTA_IPS; do
            $IPTABLES -C ALVIDAA_OTA -d $ip -j REJECT 2>/dev/null || $IPTABLES -A ALVIDAA_OTA -d $ip -j REJECT
        done
        $IPTABLES -C OUTPUT -j ALVIDAA_OTA 2>/dev/null || $IPTABLES -I OUTPUT 1 -j ALVIDAA_OTA
        for h in $OTA_HOSTS; do
            $BUSYBOX grep -q "0.0.0.0 $h" /tmp/hosts 2>/dev/null || echo "0.0.0.0 $h" >> /tmp/hosts
        done
    fi
) &
